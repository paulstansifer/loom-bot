{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "number-loom-bot",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onPostCreate": "/internal/triggers/on-post-create",
    "onCommentCreate": "/internal/triggers/on-comment-create"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true,
    "http": {
      "enable": true,
      "domains": ["i.redd.it", "preview.redd.it"]
    }
  },
  "dev": {
    "subreddit": "number_loom_bot_dev"
  }
}
